---
// Vorher/Nachher-Regler: Nachher-Bild liegt über dem Vorher-Bild und wird per Regler aufgedeckt.
// Funktioniert mit Maus, Finger und Tastatur (Pfeiltasten).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  vorher: ImageMetadata;
  nachher: ImageMetadata;
  beschreibung: string;
  eager?: boolean;
}
const { vorher, nachher, beschreibung, eager = false } = Astro.props;
const loading = eager ? 'eager' : 'lazy';
---
<figure class="ba" data-ba>
  <Picture src={vorher} formats={['avif', 'webp']} alt={`Vorher: ${beschreibung}`} widths={[480, 800, 1280]} sizes="(max-width: 860px) 100vw, 640px" loading={loading} />
  <Picture class="ba-after" src={nachher} formats={['avif', 'webp']} alt={`Nachher: ${beschreibung}`} widths={[480, 800, 1280]} sizes="(max-width: 860px) 100vw, 640px" loading={loading} />
  <span class="ba-line" aria-hidden="true">
    <span class="ba-griff">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5" /></svg>
    </span>
  </span>
  <span class="ba-label ba-label--vorher" aria-hidden="true">Vorher</span>
  <span class="ba-label ba-label--nachher" aria-hidden="true">Nachher</span>
  <input type="range" min="0" max="100" value="50" aria-label={`Vorher/Nachher vergleichen: ${beschreibung}`} />
  <!-- Nur auf dem Handy sichtbar: öffnet den Regler bildschirmfüllend. -->
  <button type="button" class="ba-gross" aria-label={`Vollbild: ${beschreibung}`} aria-pressed="false" data-vollbild>
    <svg class="ba-gross-auf" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
    <svg class="ba-gross-zu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const input = box.querySelector('input');
    if (!input) return;
    const set = () => box.style.setProperty('--pos', `${input.value}%`);
    // Vollbild: Klasse am Regler, Seite dahinter nicht scrollbar, Escape oder Kreuz schließt.
    const knopf = box.querySelector<HTMLButtonElement>('[data-vollbild]');
    const vollbild = (an: boolean) => {
      box.classList.toggle('ist-vollbild', an);
      document.documentElement.classList.toggle('vollbild-offen', an);
      knopf?.setAttribute('aria-pressed', String(an));
      if (an) input.focus();
      else knopf?.focus();
    };
    knopf?.addEventListener('click', () => vollbild(!box.classList.contains('ist-vollbild')));
    box.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && box.classList.contains('ist-vollbild')) vollbild(false);
    });

    input.addEventListener('input', () => {
      box.classList.remove('ba-hinweis');
      set();
    });
    set();
  });

  // Der erste Regler der Seite schwingt einmal kurz hin und her, wenn er ins Bild kommt,
  // damit klar ist, dass man ihn ziehen kann. Bei „Bewegung reduzieren" nicht.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const beobachter = new IntersectionObserver(
      (eintraege) =>
        eintraege.forEach((e) => {
          const box = e.target as HTMLElement;
          const karte = box.closest<HTMLElement>('[data-pos]');
          if (!e.isIntersecting || (karte && karte.dataset.pos !== 'mitte')) return;
          box.classList.add('ba-hinweis');
          box.addEventListener('animationend', () => box.classList.remove('ba-hinweis'), { once: true });
          beobachter.unobserve(box);
        }),
      { threshold: 0.6 },
    );
    const erster = document.querySelector('[data-ba]');
    if (erster) beobachter.observe(erster);
  }
</script>
