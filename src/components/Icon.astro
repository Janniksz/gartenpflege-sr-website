---
// Strichicons aus dem Design-System. Übernehmen die Textfarbe (currentColor).
interface Props {
  name: 'telefon' | 'nachricht' | 'mail' | 'kalender' | 'preis' | 'blatt' | 'instagram' | 'tiktok' | 'facebook'
    | 'rasen' | 'hecke' | 'laub' | 'gruenschnitt' | 'beete' | 'weitere';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'telefon' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'nachricht' && <path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 20.5l1.6-5.2A8.5 8.5 0 1 1 21 11.5z" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5l8.5 6.5 8.5-6.5" /></>}
  {name === 'kalender' && <><rect x="3.5" y="5" width="17" height="15.5" rx="2" /><path d="M3.5 10h17M8 3v4M16 3v4M9 15l2 2 4-4" /></>}
  {name === 'preis' && <><path d="M20.5 13.5l-7 7a1.5 1.5 0 0 1-2.1 0L3.5 12.6V3.5h9.1l7.9 7.9a1.5 1.5 0 0 1 0 2.1z" /><circle cx="8" cy="8" r="1.5" /></>}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="0.6" fill="currentColor" /></>}
  {name === 'tiktok' && <path d="M14 3.5v11a3.5 3.5 0 1 1-3.5-3.5M14 3.5c.4 2.6 2.4 4.6 5 5" />}
  {name === 'facebook' && <path d="M14.5 21v-7.5h2.8l.4-3.2h-3.2V8.4c0-.9.3-1.6 1.6-1.6h1.7V4a20 20 0 0 0-2.5-.1c-2.5 0-4.1 1.5-4.1 4.2v2.3H8.4v3.2h2.8V21" />}
  {name === 'rasen' && <path d="M3 20h18M5.5 20c0-3.5.8-6 2.5-8M9.5 20c0-5 .8-8.5 2.5-11M14 20c0-4 1-7 3-9M18 20c0-2.5.5-4.5 1.5-6" />}
  {name === 'hecke' && <><path d="M4 19v-7a3 3 0 0 1 3-3 3.5 3.5 0 0 1 5-2 3.5 3.5 0 0 1 5 2 3 3 0 0 1 3 3v7" /><path d="M3 19h18M8 13v2M12 11v2M16 13v2" /></>}
  {name === 'laub' && <><path d="M3 12c0-4 3-7 8-7-.5 5-3.5 7-8 7z" /><path d="M3 12c1.5-2 3-3.5 5-5" /><path d="M11 20c0-4 3-7 9-7-.5 5-4 7-9 7z" /><path d="M11 20c1.8-2 3.5-3.5 6-5" /></>}
  {name === 'gruenschnitt' && <><rect x="2.5" y="10" width="14" height="6" rx="1" /><circle cx="7" cy="18.5" r="1.8" /><path d="M16.5 14h5M5 10l1.5-4M9.5 10l.5-5M13 10l2-3.5" /></>}
  {name === 'beete' && <><circle cx="12" cy="7" r="3" /><path d="M12 10v11M12 17c-2.5 0-4.5-1.5-5-4 2.5 0 4.5 1.5 5 4zM12 15c2.5 0 4.5-1.5 5-4-2.5 0-4.5 1.5-5 4zM6 21h12" /></>}
  {name === 'weitere' && <><circle cx="12" cy="12" r="9" /><path d="M12 8v8M8 12h8" /></>}
  {name === 'blatt' && <><path d="M5 19c0-8 5-14 15-15-1 10-7 15-15 15z" /><path d="M5 19c3-4 6-7 10-10" /></>}
</svg>
