---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { firma, leistungen } from '../data/firma';

const projekte = (await getCollection('projekte', ({ data }) => !data.entwurf)).sort(
  (a, b) => b.data.datum.valueOf() - a.data.datum.valueOf(),
);
const mitInhalt = await Promise.all(projekte.map(async (p) => ({ p, Content: (await render(p)).Content })));

const datumFormat = new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric' });
const name = (id: string) => leistungen.find((l) => l.id === id)?.kurz ?? id;
// Filter erst ab vier Projekten und nur für Leistungen, für die es Projekte gibt.
const filter = leistungen.filter((l) => projekte.some((p) => p.data.leistungen.includes(l.id)));
---
<Base title="Referenzen" description={`Vorher/Nachher-Bilder echter Gartenprojekte in ${firma.gebiet}: Heckenschnitt, Rasen, Laub und Beete.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Referenzen</p>
      <h1 class="h1">Vorher und nachher.</h1>
      <p class="lead text-max">Echte Gärten aus {firma.gebiet}. Ziehen Sie den Regler, um den Unterschied zu sehen.</p>
    </header>

    {projekte.length === 0 ? (
      <p class="empty">Die ersten Projekte folgen in Kürze.</p>
    ) : (
      <>
        {projekte.length >= 4 && filter.length > 1 && (
          <div class="filter" role="group" aria-label="Projekte nach Leistung filtern" data-filter>
            <button type="button" aria-pressed="true" data-value="alle">Alle</button>
            {filter.map((l) => <button type="button" aria-pressed="false" data-value={l.id}>{l.kurz}</button>)}
          </div>
        )}
        <p class="sr-only" aria-live="polite" data-filter-status></p>
        <div class="projects">
          {mitInhalt.map(({ p, Content }, i) => {
            const [erstes, ...weitere] = p.data.bilder;
            return (
              <article class="project" id={p.id} data-leistungen={p.data.leistungen.join(' ')} aria-labelledby={`${p.id}-titel`}>
                <div class="project-bilder">
                  <BeforeAfter vorher={erstes.vorher} nachher={erstes.nachher} beschreibung={erstes.beschreibung} eager={i === 0} />
                  {weitere.length > 0 && (
                    <div class="project-more">
                      {weitere.map((b) => <BeforeAfter vorher={b.vorher} nachher={b.nachher} beschreibung={b.beschreibung} />)}
                    </div>
                  )}
                </div>
                <div class="project-info">
                  <p class="meta">{p.data.ort} · {datumFormat.format(p.data.datum)}</p>
                  <h2 class="h3" id={`${p.id}-titel`}>{p.data.titel}</h2>
                  <ul class="project-tags" aria-label="Leistungen">
                    {p.data.leistungen.map((l) => <li>{name(l)}</li>)}
                  </ul>
                  <div class="project-body"><Content /></div>
                  {weitere.length > 0 && <p class="meta">{weitere.length + 1} Ansichten – ziehen Sie jeweils den Regler.</p>}
                </div>
              </article>
            );
          })}
        </div>
      </>
    )}
  </div>
</Base>

<script>
  const gruppe = document.querySelector<HTMLElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (gruppe) {
    const buttons = gruppe.querySelectorAll<HTMLButtonElement>('button');
    const projekte = document.querySelectorAll<HTMLElement>('.project');
    gruppe.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      const wert = btn.dataset.value ?? 'alle';
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let sichtbar = 0;
      projekte.forEach((p) => {
        const passt = wert === 'alle' || (p.dataset.leistungen ?? '').split(' ').includes(wert);
        p.hidden = !passt;
        if (passt) sichtbar++;
      });
      if (status) status.textContent = `${sichtbar} Projekte angezeigt`;
    });
  }
</script>
