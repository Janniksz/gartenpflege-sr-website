    <header class="page-head">
      <p class="eyebrow">Fehler 404</p>
      <h1 class="h1">Hier wächst leider nichts.</h1>
      <p class="lead">Die Seite gibt es nicht oder nicht mehr.</p>
      <p><a class="btn btn--primary" href="/">Zur Startseite</a></p>
    </header>
  </div>
</Base>
