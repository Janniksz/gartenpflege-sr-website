---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { firma, leistungen } from '../data/firma';

// Texte je Leistung. „[...]" = Platzhalter, bitte ergänzen oder löschen.
// Richtpreise: Feld „preis" füllen, sobald entschieden ist, ob Preise genannt werden.
const details = [
  {
    id: 'rasen',
    titel: 'Rasenmähen',
    text: 'Ein gleichmäßig gemähter Rasen ist die Grundlage für einen gepflegten Garten. Ich mähe einmalig oder regelmäßig während der Saison.',
    dazu: 'Mähen der Rasenflächen, Rasenkanten schneiden, Schnittgut aufnehmen.',
    zeit: 'April bis Oktober, in der Hauptwachstumszeit am besten wöchentlich.',
    preis: '',
  },
  {
    id: 'hecke',
    titel: 'Hecken- und Formschnitt',
    text: 'Ob Thuja, Liguster oder Buchenhecke: Ich bringe Hecken und Formgehölze wieder in Form – sauber und gerade.',
    dazu: 'Schnitt der Seiten und der Oberkante, Schnittgut zusammenrechen und auf Wunsch mitnehmen.',
    zeit: 'Formschnitt im Juni und im Spätsommer. Ein starker Rückschnitt ist nur von Oktober bis Februar erlaubt (§ 39 Bundesnaturschutzgesetz).',
    preis: '',
  },
  {
    id: 'laub',
    titel: 'Laubentfernung',
    text: 'Laub, das zu lange liegen bleibt, nimmt dem Rasen das Licht. Ich räume Rasen, Beete und Wege frei.',
    dazu: 'Laub zusammentragen und auf Wunsch mitnehmen.',
    zeit: 'Oktober und November, bei vielen Bäumen auch mehrmals.',
    preis: '',
  },
  {
    id: 'gruenschnitt',
    titel: 'Entsorgung von Grünschnitt',
    text: 'Kein Hänger, keine Fahrt zum Wertstoffhof: Grünschnitt, Laub und Schnittgut nehme ich mit und entsorge sie fachgerecht.',
    dazu: 'Aufladen und Abtransport des Grünschnitts.',
    zeit: 'Das ganze Jahr, meist zusammen mit Heckenschnitt oder Laubentfernung.',
    preis: '',
  },
  {
    id: 'beete',
    titel: 'Pflege von Sträuchern und Beeten',
    text: 'Damit Beete und Sträucher schön bleiben, brauchen sie regelmäßig etwas Aufmerksamkeit.',
    dazu: 'Unkraut jäten, Verblühtes entfernen, Sträucher schneiden und auslichten.',
    zeit: 'März bis November.',
    preis: '',
  },
  {
    id: 'weitere',
    titel: 'Weitere Gartenarbeiten auf Anfrage',
    text: 'Etwas anderes zu tun? Sprechen Sie mich an – vieles lässt sich einrichten.',
    dazu: '',
    zeit: '',
    preis: '',
  },
];
---
<Base title="Leistungen" description={`Rasenmähen, Hecken- und Formschnitt, Laubentfernung, Grünschnitt-Entsorgung und Beetpflege in ${firma.gebiet}. Was dazugehört und wann es dran ist.`}>
  <div class="container">
    <header class="page-head">
      <p class="eyebrow">Leistungen</p>
      <h1 class="h1">Was ich für Ihren Garten tue.</h1>
      <p class="lead text-max">Gartenpflege in {firma.gebiet} – einmalig oder regelmäßig. Den Preis bespreche ich immer vorab mit Ihnen.</p>
    </header>

    <nav class="schnellnav" aria-label="Zu einer Leistung springen" data-schnellnav>
      <div class="schnellnav-liste">
        {leistungen.map((l) => (
          <a href={`#${l.id}`} data-ziel={l.id}><Icon name={l.id} />{l.kurz}</a>
        ))}
      </div>
    </nav>

    <div class="service-details">
    {details.map((d) => (
      d.dazu ? (
        <details class="service-detail" id={d.id}>
          <summary>
            <h2 class="h4">{d.titel}</h2>
            <span class="service-vorschau">{d.text}</span>
            <span class="service-mehr">
              <span class="service-mehr-zu">Mehr erfahren</span>
              <span class="service-mehr-auf">Weniger anzeigen</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </span>
          </summary>
          <dl>
            <dt>Was dazugehört</dt>
            <dd>{d.dazu}</dd>
            <dt>Beste Zeit</dt>
            <dd>{d.zeit}</dd>
            {d.preis && <><dt>Richtpreis</dt><dd>{d.preis}</dd></>}
          </dl>
        </details>
      ) : (
        <section class="service-detail service-detail--einfach" id={d.id} aria-labelledby={`${d.id}-titel`}>
          <h2 class="h4" id={`${d.id}-titel`}>{d.titel}</h2>
          <p class="service-vorschau">{d.text}</p>
          <a class="service-mehr" href="#kontakt">Unverbindlich anfragen</a>
        </section>
      )
    ))}
    </div>
  </div>

  <section class="section section--forest" aria-labelledby="ablauf-titel">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Ablauf</p>
        <h2 class="h2" id="ablauf-titel">So läuft's ab.</h2>
      </div>
      <ol class="steps">
        <li><h3>Anfrage</h3><p>Rufen Sie an oder schreiben Sie per WhatsApp, was zu tun ist.</p></li>
        <li><h3>Besichtigung</h3><p>Ich schaue mir Ihren Garten kurz vor Ort an.</p></li>
        <li><h3>Preis vorab</h3><p>Sie erfahren den Preis, bevor ich anfange. Ohne Überraschungen.</p></li>
        <li><h3>Erledigung</h3><p>Ich arbeite zum vereinbarten Termin und hinterlasse alles ordentlich.</p></li>
      </ol>
    </div>
  </section>

  <section class="section section--sunken" aria-labelledby="faq-titel">
    <div class="container">
    <div class="section-head">
      <p class="eyebrow">Häufige Fragen</p>
      <h2 class="h2" id="faq-titel">Gut zu wissen.</h2>
    </div>
    <div class="faq">
      <details>
        <summary>Was kostet die Gartenpflege?</summary>
        <p>Das hängt von Größe und Zustand des Gartens ab. Nach einer kurzen Besichtigung nenne ich Ihnen den Preis vorab und transparent.</p>
      </details>
      <details>
        <summary>Nehmen Sie den Grünschnitt mit?</summary>
        <p>Ja, auf Wunsch nehme ich Grünschnitt, Laub und Schnittgut mit und entsorge sie fachgerecht.</p>
      </details>
      <details>
        <summary>Gibt es auch regelmäßige Pflege?</summary>
        <p>Ja, regelmäßige Pflege können Sie gerne anfragen. Wie oft ich komme, stimmen wir gemeinsam ab, passend zu Ihrem Garten und Ihren Wünschen.</p>
      </details>
      <details>
        <summary>Wie schnell bekomme ich einen Termin?</summary>
        <p>Melden Sie sich einfach. Bei der Anfrage nenne ich Ihnen den nächsten freien Termin.</p>
      </details>
    </div>
    </div>
  </section>
</Base>

<script>
  // Sprünge zu einer Leistung: Die Karte steht senkrecht mittig im sichtbaren Bereich
  // (unter Kopfzeile und Schnellnavigation, über der Anruf-Leiste) und leuchtet kurz auf.
  const karten = [...document.querySelectorAll<HTMLElement>('.service-detail')];
  const knoepfe = [...document.querySelectorAll<HTMLAnchorElement>('[data-ziel]')];
  const navListe = document.querySelector<HTMLElement>('.schnellnav-liste');
  const karteVon = (id: string) => karten.find((k) => k.id === id) ?? null;
  let markiert = '';
  let gesperrtBis = 0;

  const zielPosition = (karte: HTMLElement) => {
    const kopf = document.querySelector('.site-header');
    const nav = document.querySelector('[data-schnellnav]');
    const leiste = document.querySelector('.anruf-leiste');
    const oben =
      (kopf && getComputedStyle(kopf).position === 'sticky' ? kopf.getBoundingClientRect().height : 0) +
      (nav ? nav.getBoundingClientRect().height : 0);
    const unten = leiste && getComputedStyle(leiste).display !== 'none' ? leiste.getBoundingClientRect().height : 0;
    const platz = window.innerHeight - oben - unten;
    const r = karte.getBoundingClientRect();
    const abstand = r.height < platz ? (platz - r.height) / 2 : 16;
    return r.top + window.scrollY - oben - abstand;
  };

  // Genau einen Knopf markieren und ihn auf dem Handy in die Mitte der Leiste schieben.
  const markiere = (id: string) => {
    if (id === markiert) return;
    markiert = id;
    knoepfe.forEach((k) => {
      if (k.dataset.ziel === id) {
        k.setAttribute('aria-current', 'true');
        navListe?.scrollTo({ left: k.offsetLeft - (navListe.clientWidth - k.offsetWidth) / 2, behavior: 'smooth' });
      } else k.removeAttribute('aria-current');
    });
  };

  const aufleuchten = (karte: HTMLElement) => {
    karte.classList.remove('ist-ziel');
    void karte.offsetWidth; // Animation neu starten
    karte.classList.add('ist-ziel');
  };

  const springe = (karte: HTMLElement, verhalten: ScrollBehavior) => {
    gesperrtBis = performance.now() + 1200; // währenddessen markiert das Scrollen nichts um
    if (karte instanceof HTMLDetailsElement) karte.open = true; // angesprungene Karte aufklappen
    markiere(karte.id);
    window.scrollTo({ top: zielPosition(karte), behavior: verhalten });
  };

  // Beim Öffnen über /leistungen#hecke
  const start = karteVon(decodeURIComponent(location.hash.slice(1)));
  if (start) {
    springe(start, 'instant');
    window.addEventListener('load', () => springe(start, 'instant'), { once: true });
  }

  // Klick in der Schnellnavigation: nur unser eigenes, sanftes Scrollen (kein Browser-Sprung).
  knoepfe.forEach((k) =>
    k.addEventListener('click', (e) => {
      const karte = karteVon(k.dataset.ziel ?? '');
      if (!karte) return;
      e.preventDefault();
      history.replaceState(null, '', `#${karte.id}`);
      springe(karte, 'smooth');
      aufleuchten(karte);
    }),
  );
  window.addEventListener('hashchange', () => {
    const karte = karteVon(decodeURIComponent(location.hash.slice(1)));
    if (karte) {
      springe(karte, 'smooth');
      aufleuchten(karte);
    }
  });

  // Sanftes Auf- und Zuklappen: Die Höhe der Karte wird animiert (bei „Bewegung reduzieren“ nicht).
  const sanft = !matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLDetailsElement>('details.service-detail').forEach((karte) => {
    let animation: Animation | null = null;
    karte.querySelector('summary')?.addEventListener('click', (e) => {
      if (!sanft) return;
      e.preventDefault();
      const oeffnen = !karte.open || karte.classList.contains('schliesst');
      const von = karte.getBoundingClientRect().height;
      animation?.cancel();
      // Zielhöhe messen: kurz in den Endzustand schalten.
      karte.open = oeffnen;
      const nach = karte.getBoundingClientRect().height;
      karte.open = true;
      karte.classList.toggle('schliesst', !oeffnen);
      karte.style.overflow = 'hidden';
      animation = karte.animate({ height: [`${von}px`, `${nach}px`] }, { duration: 300, easing: 'cubic-bezier(0.22, 0.7, 0.2, 1)' });
      animation.finished
        .then(() => {
          karte.open = oeffnen;
          karte.classList.remove('schliesst');
          karte.style.overflow = '';
        })
        .catch(() => {}); // abgebrochen durch erneutes Klicken: die neue Animation übernimmt
    });
  });

  // Beim Scrollen die Leistung markieren, die auf Höhe der Bildschirmmitte liegt.
  // Stehen zwei Karten nebeneinander, bleibt die gewählte markiert, sonst die linke.
  let geplant = false;
  const pruefe = () => {
    geplant = false;
    if (performance.now() < gesperrtBis || !karten.length) return;
    const mitte = window.innerHeight / 2;
    const reihe = karten.filter((k) => {
      const r = k.getBoundingClientRect();
      return r.top <= mitte && r.bottom >= mitte;
    });
    if (reihe.length) markiere(reihe.some((k) => k.id === markiert) ? markiert : reihe[0].id);
    else if (mitte < karten[0].getBoundingClientRect().top || mitte > karten[karten.length - 1].getBoundingClientRect().bottom) markiere('');
  };
  window.addEventListener(
    'scroll',
    () => {
      if (!geplant) {
        geplant = true;
        requestAnimationFrame(pruefe);
      }
    },
    { passive: true },
  );
</script>
