---
import '../styles/tokens.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import ContactBand from '../components/ContactBand.astro';
import SanftesScrollen from '../components/SanftesScrollen.astro';
import Einblenden from '../components/Einblenden.astro';
import AnrufLeiste from '../components/AnrufLeiste.astro';
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import logo from '../assets/logo/firmenlogo.png';
import { firma } from '../data/firma';

interface Props {
  title: string;
  description: string;
  kontakt?: boolean; // Kontaktband unten anzeigen
  noindex?: boolean;
}
const { title, description, kontakt = true, noindex = false } = Astro.props;
const fullTitle = Astro.url.pathname === '/' ? `${firma.name} – Gartenpflege in ${firma.gebiet}` : `${title} | ${firma.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Social-Media-Profile mit echter Adresse; Platzhalter in firma.ts werden nicht angezeigt.
const profile = firma.social.filter((s) => s.url.startsWith('http'));

// Strukturierte Daten für Google (lokales Unternehmen).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: firma.name,
  description: `Gartenpflege in ${firma.gebiet}: Rasenmähen, Hecken- und Formschnitt, Laubentfernung, Grünschnitt-Entsorgung, Pflege von Sträuchern und Beeten.`,
  telephone: firma.telefonLink.replace('tel:', ''),
  email: firma.email,
  url: Astro.site?.toString(),
  logo: new URL('/logo.png', Astro.site).toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: firma.anschrift.strasse,
    postalCode: firma.anschrift.plz,
    addressLocality: firma.anschrift.ort,
    addressCountry: 'DE',
  },
  areaServed: firma.orte.filter((o) => !o.startsWith('[')),
  sameAs: profile.map((s) => s.url),
};
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/fraunces-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#1F3B2C" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={firma.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-bild.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${firma.name} – Gartenpflege in ${firma.gebiet}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <Header />
    <main id="inhalt">
      <slot />
    </main>
    {kontakt && <ContactBand />}
    <footer class="site-footer">
      <div class="container footer-raster">
        <div class="footer-marke">
          <Image src={logo} alt={firma.name} height={64} densities={[1, 2]} />
          <p class="muted">{firma.claim}<br />Gartenpflege in {firma.gebiet}.</p>
        </div>
        <nav aria-labelledby="footer-seiten">
          <p class="footer-titel" id="footer-seiten">Seiten</p>
          <ul class="footer-liste">
            <li><a href="/">Start</a></li>
            <li><a href="/leistungen">Leistungen</a></li>
            <li><a href="/referenzen">Referenzen</a></li>
            <li><a href="/gartenkalender">Gartenkalender</a></li>
            <li><a href="/ueber-mich">Über mich</a></li>
          </ul>
        </nav>
        <div>
          <p class="footer-titel">Kontakt</p>
          <ul class="footer-liste">
            <li><a href={firma.telefonLink}><Icon name="telefon" />{firma.telefonAnzeige}</a></li>
            <li><a href={firma.whatsappLink}><Icon name="nachricht" />WhatsApp</a></li>
            <li><a href={firma.emailLink}><Icon name="mail" />{firma.email}</a></li>
          </ul>
        </div>
        {profile.length > 0 && (
          <div>
            <p class="footer-titel">Folgen</p>
            <ul class="social" aria-label="Social Media">
              {profile.map((s) => (
                <li><a href={s.url} target="_blank" rel="noopener" aria-label={`${firma.name} auf ${s.name}`}><Icon name={s.id} /></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
      <div class="container footer-unten">
        <p>© {new Date().getFullYear()} {firma.name}</p>
        <nav aria-label="Rechtliches">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
        </nav>
      </div>
    </footer>
    <SanftesScrollen />
    <Einblenden />
    <AnrufLeiste />
  </body>
</html>
